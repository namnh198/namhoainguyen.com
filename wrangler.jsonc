{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namhoainguyen",
  "compatibility_date": "2026-08-17",
  "main": "./workers/app.ts",
  "vars": {
    "NOTION_SCHEMA_TITLE": "title",
    "NOTION_SCHEMA_SLUG": "Fxoz",
    "NOTION_SCHEMA_PUBLISHED": "N|TD",
    "NOTION_SCHEMA_PINNED": "QES=",
    "NOTION_SCHEMA_VERIFIED": ";vXQ",
    "NOTION_SCHEMA_DISCRETE": "xZ_D",
    "NOTION_SCHEMA_HIDE": "Iq;T",
    "NOTION_SCHEMA_DESCRIPTION": "S@J<",
    "NOTION_SCHEMA_TAGS": "LOXq",
    "NOTION_SCHEMA_LANGUAGE": "tEJX",
    "NOTION_SCHEMA_LAST_MODIFIED": "iyy?",
    "NOTION_BOLD_SEARCH_KEY": "gzkNfoUU"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true
    }
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "cache": {
    "enabled": true
  },
  "assets": { "directory": "./build/client/", "binding": "ASSETS" }
}
